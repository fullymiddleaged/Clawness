__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
# ...but the OpenClaw adapter ships its prebuilt entry (git installs don't build).
# Re-include the directory so openclaw/.gitignore can expose dist/src (only).
!openclaw/dist/
build/
.eggs/
*.egg
.venv/
venv/
.env
*.tar.gz
# Clawness — per-machine session state (memory.md and rules/ stay shared)
.clawness/*
!.clawness/memory.md
!.clawness/rules/
.clawness_prewarm.py
.pytest_cache/
